# Local development works without any environment variables.
# Add this secret in Vercel's environment settings, then redeploy:
# GITHUB_TOKEN=

# Optional:
# GITHUB_REPOSITORY=dmerckx/pass-the-bigs
# GITHUB_STATE_BRANCH=game-state
# STATE_ENCRYPTION_KEY=
# VAPID_SUBJECT=https://github.com/dmerckx/pass-the-bigs
# LOCAL_STATE_PATH=.data/state.json
# HOST=0.0.0.0
# PORT=3007

# Set only when deliberately testing GitHub-backed storage locally:
# STATE_BACKEND=github
